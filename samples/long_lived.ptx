.version 7.5
.target sm_80
.address_size 64

.visible .entry long_lived(
    .param .u64 in,
    .param .u64 out,
    .param .u32 iters,
    .param .f32 alpha,
    .param .f32 beta
)
{
    .reg .pred %p<4>;
    .reg .b32 %r<8>;
    .reg .b64 %rd<8>;
    .reg .f32 %f<16>;

    ld.param.u32 %r0, [iters];
    ld.param.f32 %f8, [alpha];
    ld.param.f32 %f9, [beta];

    mul.f32 %f0, %f8, 3.14159;
    mul.f32 %f1, %f9, 2.71828;
    add.f32 %f10, %f8, %f9;
    mul.f32 %f2, %f10, 0.5;

    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ntid.x;
    mov.u32 %r3, %tid.x;
    mad.lo.s32 %r4, %r1, %r2, %r3;

    ld.param.u64 %rd0, [in];
    ld.param.u64 %rd1, [out];

    mul.wide.s32 %rd2, %r4, 4;
    add.s64 %rd3, %rd0, %rd2;
    ld.global.f32 %f3, [%rd3];

    mov.u32 %r5, 0;

L_loop:
    setp.ge.s32 %p0, %r5, %r0;
    @%p0 bra L_loop_end;

    fma.rn.f32 %f4, %f3, 1.001, 0.05;
    fma.rn.f32 %f5, %f4, 0.999, 0.02;
    add.f32 %f6, %f4, %f5;
    mul.f32 %f3, %f6, 0.5;

    add.s32 %r5, %r5, 1;
    bra L_loop;

L_loop_end:
    setp.gt.f32 %p1, %f3, 1000.0;
    @%p1 bra L_then;

    fma.rn.f32 %f7, %f3, %f1, %f2;
    bra L_store;

L_then:
    fma.rn.f32 %f7, %f3, %f0, %f1;

L_store:
    add.s64 %rd4, %rd1, %rd2;
    st.global.f32 [%rd4], %f7;
    ret;
}
