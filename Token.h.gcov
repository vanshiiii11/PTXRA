        -:   34:    DotByte,            // .byte (data initializer)
        -:   35:    DotWord,            // .word
        -:   36:    DotU32,             // type directives used inside .reg/.param
        -:   37:    DotU64,
        -:   38:    DotS32,
        -:   39:    DotS64,
        -:   40:    DotB8, DotB16, DotB32, DotB64,
        -:   41:    DotU8,  DotU16,
        -:   42:    DotS8,  DotS16,
        -:   43:    DotF16, DotF32, DotF64,
        -:   44:    DotPred,            // .pred
        -:   45:    DotV2, DotV4,       // vector types
        -:   46:    DotLo, DotHi, DotWide, // mul modifiers
        -:   47:    DotRn, DotRz, DotRm, DotRp, // rounding modes
        -:   48:    DotFtz,             // flush-to-zero
        -:   49:    DotSat,             // saturate
        -:   50:    DotEq, DotNe, DotLt, DotLe, DotGt, DotGe,  // setp comparison
        -:   51:    DotEqu, DotNeu, DotLtu, DotLeu, DotGtu, DotGeu, // unordered
        -:   52:    DotNum, DotNan,     // setp ordered/unordered
        -:   53:    DotLs, DotHs,       // unsigned lt/ge for setp
        -:   54:    DotGlobal_space,    // .global as address-space qualifier (duplicated for clarity)
        -:   55:    DotShared_space,    // .shared as address-space qualifier
        -:   56:    DotParam_space,     // .param as address-space qualifier
        -:   57:    DotLocal_space,     // .local as address-space qualifier
        -:   58:    DotGeneric,         // .generic
        -:   59:    DotAnd,             // .and atom modifier
        -:   60:    DotOr,              // .or atom modifier
        -:   61:    DotAdd,             // .add atom modifier
        -:   62:    DotXor,             // .xor atom modifier
        -:   63:    DotMin,             // .min atom modifier
        -:   64:    DotMax,             // .max atom modifier
        -:   65:    DotCas,             // .cas atom modifier
        -:   66:    DotExch,            // .exch atom modifier
        -:   67:    DotTo,              // .to cvta modifier
        -:   68:    DotSync,            // .sync (bar.sync)
        -:   69:    DotCta,             // .cta (scope)
        -:   70:    DotGpu,
        -:   71:    DotSys,
        -:   72:
        -:   73:    // Punctuation / symbols
        -:   74:    LParen,     // (
        -:   75:    RParen,     // )
        -:   76:    LBrace,     // {
        -:   77:    RBrace,     // }
        -:   78:    LBracket,   // [
