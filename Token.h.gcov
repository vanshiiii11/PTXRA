        -:   99:    Eof,
        -:  100:    Unknown,    // illegal character — lexer emits this and continues
        -:  101:};
        -:  102:
        -:  103:/// Human-readable name for a TokenKind (for diagnostics).
        -:  104:std::string_view tokenKindName(TokenKind k);
        -:  105:
        -:  106:/// A single lexed token.
     8148:  107:struct Token {
        -:  108:    TokenKind      kind     = TokenKind::Unknown;
        -:  109:    std::string    text;           // raw source spelling
        -:  110:    SourceLocation loc;
        -:  111:
        -:  112:    // Convenience constructors
        -:  113:    Token() = default;
    14306:  114:    Token(TokenKind k, std::string t, SourceLocation l)
    14306:  115:        : kind(k), text(std::move(t)), loc(std::move(l)) {}
        -:  116:
        -:  117:    bool is(TokenKind k)    const { return kind == k; }
        -:  118:    bool isNot(TokenKind k) const { return kind != k; }
        -:  119:    bool isEof()            const { return kind == TokenKind::Eof; }
        -:  120:
        -:  121:    /// True for any type-qualifier dot token (.b32, .f32, .pred, …)
        -:  122:    bool isTypeQualifier() const;
        -:  123:    /// True for any address-space dot token (.global, .shared, .param, .local)
        -:  124:    bool isAddressSpace()  const;
        -:  125:    /// True for any setp comparison modifier (.eq, .ne, .lt, …)
        -:  126:    bool isCmpOp()         const;
        -:  127:};
